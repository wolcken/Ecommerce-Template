{
  "name": "ecommerce-base",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/run-emulators.mjs",
    "emulators": "node scripts/run-emulators.mjs --start",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "firebase:check": "node scripts/check-firebase.mjs",
    "firebase:admin": "node --use-system-ca scripts/admin-role.mjs",
    "firebase:smoke": "node --use-system-ca scripts/check-live-rules.mjs",
    "firebase:deploy": "node --use-system-ca node_modules/firebase-tools/lib/bin/firebase.js deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "^15.32.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "yarn": "1.22.x",
    "node": ">=24.13.0 <25"
  }
}

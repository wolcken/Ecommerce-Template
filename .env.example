# Copiar a .env.local. Reiniciar yarn dev después de cambiar valores.
# demo = catálogo ficticio sin conexión. firebase = servicios reales.
VITE_DATA_SOURCE=demo

# Configuración pública de la app WEB (Firebase > Configuración del proyecto).
# NO pegar claves privadas, cuentas de servicio ni credenciales Admin SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Región del backend (debe coincidir con las funciones desplegadas)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

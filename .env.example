# Copiar a .env.local. Reiniciar yarn dev después de cambiar valores.
# demo = catálogo ficticio sin conexión. firebase = Authentication + Firestore.
VITE_DATA_SOURCE=demo

# Configuración pública de la app WEB (Firebase > Configuración del proyecto).
# No pegar claves privadas, cuentas de servicio ni credenciales Admin SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Carga pública de imágenes con un preset unsigned de Cloudinary.
# Estos valores se incluyen en el frontend. Nunca agregar API_SECRET.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Esta base Spark no usa Firebase Storage ni Cloud Functions.
